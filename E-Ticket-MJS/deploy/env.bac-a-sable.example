# Essai Orange Money en BAC À SABLE (gratuit) — d'après le portail développeur Orange (voir DOCUMENTATION.md §5.2).
# Copier en .env pour tester sans argent réel. Ne convient PAS à la production (NODE_ENV reste « development »).
NODE_ENV=development
PROVIDER_ORANGE=live
PROVIDER_CINETPAY=off
PROVIDER_MOOV=off
# Clé « Authorization » fournie par le portail développeur : "Basic " + base64(client_id:client_secret)
OM_AUTH_HEADER=Basic VOTRE_CLE_DEVELOPER_ENCODEE_BASE64
OM_MERCHANT_KEY=VOTRE_MERCHANT_KEY
OM_COUNTRY=dev            # bac à sable
OM_CURRENCY=OUV           # devise de test ; en production : XOF (confirmé par Orange)
# Adresse publique obligatoire pour recevoir la notification d'Orange (sinon : tunnel type ngrok/cloudflared vers localhost:3000)
BASE_URL=https://VOTRE-TUNNEL-OU-DOMAINE
ADMIN_KEY=cle-admin-de-test
CONTROL_KEY=cle-borne-de-test
