# Alternative sans Docker : Node 22.13+ installé sur le serveur.
# Copier le projet dans /opt/eticket, créer /opt/eticket/.env, puis :
#   sudo cp deploy/eticket.service /etc/systemd/system/ && sudo systemctl enable --now eticket
[Unit]
Description=E-Ticket Mali
After=network.target

[Service]
User=eticket
WorkingDirectory=/opt/eticket
EnvironmentFile=/opt/eticket/.env
Environment=DB_PATH=/var/lib/eticket/eticket.sqlite
Environment=TZ=UTC
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/eticket
StateDirectory=eticket

[Install]
WantedBy=multi-user.target
