# Copier ce fichier en ".env" puis adapter. Ne jamais publier ni versionner le fichier .env.

# ---- Site ----
DOMAIN=billetterie.exemple.ml          # utilisé par Caddy (HTTPS automatique) ; doit pointer vers le serveur
BASE_URL=https://billetterie.exemple.ml  # adresse publique : retours de paiement + notifications des opérateurs
NODE_ENV=production                    # en production, le serveur refuse de démarrer si la config est dangereuse
ORDER_TTL_MIN=15                       # durée de réservation des places avant paiement

# ---- Clés secrètes (générer : openssl rand -hex 24) ----
ADMIN_KEY=                             # administration (événements, tarifs, statistiques) – 24 caractères min.
CONTROL_KEY=                           # bornes d'entrée : peut seulement contrôler les billets – 16 caractères min.
                                       # plusieurs clés possibles, séparées par des virgules (une par équipe/borne)

# ---- Paiement : live (réel) | mock (simulation, interdit en production) | off (désactivé) ----
PROVIDER_ORANGE=live
PROVIDER_MOOV=live                     # live dès que Moov a fourni l'adresse (MOOV_URL) et les identifiants

# Orange Money Web Payment (fournis par Orange après ouverture du compte marchand)
OM_AUTH_HEADER=Basic xxxxxxxxxxxxxxxx
OM_MERCHANT_KEY=
OM_COUNTRY=dev                         # sandbox : dev — production : code pays donné par Orange pour le Mali
OM_CURRENCY=OUV                        # sandbox : OUV — production : XOF (à confirmer avec Orange)
#OM_BASE_URL=https://api.orange.com
#OM_OAUTH_URL=https://api.orange.com/oauth/v3/token
# Orange Money — variante « directe » (flux fourni par Orange, fichier flow_paiement_OM) : à la place de OM_AUTH_HEADER
#OM_CLIENT_ID=
#OM_CLIENT_SECRET=
#OM_WEBPAYMENT_URL=                   # adresse de création du paiement donnée par Orange (sandbox ou production)

# Moov Money Mali — API directe (document « Spécifications Techniques : Intégration API Directe Moov Money Mali »)
# Push USSD : l'acheteur saisit son code PIN sur son téléphone (pas de redirection). Protocole SOAP/XML en HTTPS.
MOOV_URL=                              # point de terminaison communiqué par Moov (sandbox puis production)
MOOV_MERCHANT_ID=                      # merchantId affecté par Moov
MOOV_PASSWORD=                         # password fourni par Moov après validation sandbox (SECRET)
#MOOV_NAMESPACE=http://malitel.ml/moovmoney
#MOOV_SOAP_ACTION=                     # si Moov l'exige ; {op} = nom de l'opération
MOOV_CALLBACK_IPS=                     # adresses IP de la passerelle Moov autorisées à appeler /api/webhooks/moov (obligatoire en production)

# ---- SMS (récupération des billets) : console (développement) | http (passerelle de votre fournisseur) ----
# SMS_PROVIDER : console (essais) | twilio | orange | http
#   twilio : SMS_TWILIO_SID, SMS_TWILIO_TOKEN, SMS_FROM (ou SMS_TWILIO_MESSAGING_SERVICE)
#   orange : SMS_ORANGE_CLIENT_ID, SMS_ORANGE_CLIENT_SECRET, SMS_ORANGE_SENDER (numéro expéditeur +223… attribué par Orange)
#   http   : SMS_URL, SMS_AUTH_HEADER, SMS_BODY_TEMPLATE (autre fournisseur)
SMS_PROVIDER=http
SMS_URL=
SMS_AUTH_HEADER=                       # ex. Bearer xxxx
SMS_BODY_TEMPLATE={"to":"{to}","message":"{message}"}   # à adapter à la documentation du fournisseur

# ---- Sauvegardes ----
BACKUP_KEEP=14

# Textes juridiques : mettre 1 UNIQUEMENT après validation par le service juridique et complétion des passages
# surlignés (public/conditions.html, public/confidentialite.html ; sources dans deploy/build-legal.py).
LEGAL_VALIDATED=0
# Limite de commandes par adresse IP et par 10 min (élevée : plusieurs abonnés mobiles partagent souvent une adresse).
# RATE_ORDERS_PER_10MIN=100

# CinetPay : guichet unique Orange Money, Moov, Wave, Sama Money (proposé avec Orange et Moov en direct ; ENABLE_CINETPAY=0 pour le masquer).
# Les clés se trouvent dans le back-office CinetPay (compte marchand validé) : « Intégration » → clé API et identifiant du site.
PROVIDER_CINETPAY=mock            # mock = simulation ; live = vrai guichet
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_CHANNELS=MOBILE_MONEY    # ALL, MOBILE_MONEY, CREDIT_CARD, WALLET
CINETPAY_CURRENCY=XOF

# ---- Hébergement Netlify (fonctions initier_paiement / webhook_cinetpay) : à saisir dans Netlify > Environment variables (portée « Functions »), PAS dans ce fichier ----
# MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/   # MongoDB Atlas (transactions, billets, liens courts)
# MONGODB_DB=eticket
# SITE_URL=https://billets.votre-domaine.ml      # adresse publique (notify_url, return_url, liens courts des SMS)
# CONTROL_KEY=                                    # clé du personnel de contrôle pour /api/cinetpay/valider
# RESERVATION_TTL_MIN=15                          # durée de réservation des places pendant le paiement
# Base SQL : Netlify Database (PostgreSQL) — créée automatiquement ; migrations dans netlify/database/migrations/.
# Numéro Orange Money du ministère pour les encaissements directs (information interne, jamais affiché sur le site) :
ORANGE_MERCHANT_MSISDN=91765870

# En développement (hors production), si ADMIN_KEY / CONTROL_KEY sont vides : admin-eticket-2026 / controle-eticket-2026.
# En production ces valeurs par défaut sont REFUSÉES au démarrage.

# Comptes du personnel : « clé » ou « Nom=clé », séparés par des virgules (les noms apparaissent dans les journaux ; seules les empreintes sont stockées en base).
# ADMIN_KEY=Direction=...  CONTROL_KEY=Porte nord=...,Porte sud=...
# Bases : DB_PATH = base utilisateurs ; admin.sqlite, personnel.sqlite, controle/ et journal/ sont créés à côté (voir BASES-DE-DONNEES.md).
